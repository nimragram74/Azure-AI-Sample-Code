# Copy this file to ".env" and fill in the values from your Azure AI Foundry deployment.
# Foundry portal -> your project -> Models + endpoints -> open your deployment.

# The endpoint URL of your Azure OpenAI / Foundry resource
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/

# The DEPLOYMENT name you chose when deploying the model (NOT the model name)
AZURE_OPENAI_DEPLOYMENT=chat-gpt4o-mini

# API version (a recent stable value)
AZURE_OPENAI_API_VERSION=2024-10-21

# Auth mode: "entra" (recommended, keyless) or "key"
AUTH_MODE=entra

# Only needed if AUTH_MODE=key
AZURE_OPENAI_API_KEY=
